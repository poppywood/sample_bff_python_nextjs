AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_ROLES_CLAIM=https://example.com/roles
FRONTEND_ORIGIN=http://localhost:3000
BFF_BASE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
SESSION_COOKIE_NAME=bff_session
SESSION_COOKIE_DOMAIN=
SESSION_TTL_SECONDS=28800
SESSION_SECURE_COOKIES=false
OAUTH_STATE_SECRET=replace-with-a-long-random-string
INTERNAL_JWT_PRIVATE_KEY_PATH=keys/internal_private.pem
INTERNAL_JWT_ISSUER=sample-bff
INTERNAL_JWT_AUDIENCE=service-a
SERVICE_A_BASE_URL=http://localhost:8001
